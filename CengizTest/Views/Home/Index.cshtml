@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to ASP.NET Core + Vite + Tailwind</h1>
    <p class="text-gray-600">
        A modern starter template with
        <a href="https://tailwindcss.com" class="text-blue-600 hover:text-blue-800 underline" target="_blank">Tailwind CSS</a>,
        <a href="https://vitejs.dev" class="text-blue-600 hover:text-blue-800 underline" target="_blank">Vite</a>, and
        <a href="https://jquery.com" class="text-blue-600 hover:text-blue-800 underline" target="_blank">jQuery</a>
    </p>
</div>

<div class="grid md:grid-cols-2 gap-6">
    <!-- Card 1: UI Components -->
    <div class="card">
        <div class="card-header">
            <svg class="inline w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
            </svg>
            UI Components
        </div>
        <div class="card-body">
            <h5 class="card-title">Interactive Tailwind Components</h5>

            <!-- Buttons -->
            <div class="space-x-2 mb-4">
                <button class="btn btn-primary">Primary</button>
                <button class="btn btn-secondary">Secondary</button>
                <button class="btn btn-success">Success</button>
                <button class="btn btn-danger">Danger</button>
            </div>

            <!-- Collapse example -->
            <button id="toggleCollapse" class="btn btn-primary mb-2">
                Toggle Collapse
            </button>
            <div id="collapseContent" class="hidden">
                <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-blue-800">
                    This is collapsible content using jQuery and Tailwind!
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: AJAX Example -->
    <div class="card">
        <div class="card-header">
            <svg class="inline w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
            </svg>
            jQuery AJAX Example
        </div>
        <div class="card-body">
            <h5 class="card-title">Test jQuery & AJAX</h5>
            <p class="text-gray-600 mb-4">Click the button to simulate an AJAX request.</p>

            <button id="ajaxButton" class="btn btn-success">
                Load Data
            </button>

            <div id="ajaxResult"></div>
        </div>
    </div>
</div>

<!-- Form Example -->
<div class="card mt-6">
    <div class="card-header">
        <svg class="inline w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Form Example
    </div>
    <div class="card-body">
        <div class="grid md:grid-cols-2 gap-4">
            <div class="form-group">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" placeholder="Enter your name">
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" placeholder="Enter your email">
            </div>
            <div class="form-group">
                <label class="form-label">Country</label>
                <select class="form-select">
                    <option>Select a country</option>
                    <option>Turkey</option>
                    <option>USA</option>
                    <option>UK</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Message</label>
                <textarea class="form-control" rows="3" placeholder="Your message"></textarea>
            </div>
        </div>
        <button class="btn btn-primary">Submit</button>
    </div>
</div>

