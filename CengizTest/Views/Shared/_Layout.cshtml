@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@inject IWebHostEnvironment Environment

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CengizTest</title>
    
    @if (Environment.IsDevelopment())
    {
        <!-- Development - Vite dev server -->
        <script type="module" src="http://localhost:5173/@@vite/client"></script>
        <script type="module" src="http://localhost:5173/js/main.js"></script>
    }
    else
    {
        <!-- Production - bundled assets -->
        @await Html.PartialAsync("_ViteImports")
    }
</head>
<body>
    <header>
        <nav class="bg-white border-b shadow-md mb-3 fixed top-0 w-full z-50">
            <div class="container mx-auto px-4">
                <div class="flex justify-between items-center h-16">
                    <a class="text-xl font-semibold text-gray-900" asp-area="" asp-controller="Home" asp-action="Index">CengizTest</a>

                    <!-- Mobile menu button -->
                    <button id="mobile-menu-button" type="button" class="sm:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500" aria-controls="mobile-menu" aria-expanded="false">
                        <span class="sr-only">Toggle navigation</span>
                        <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <!-- Desktop menu -->
                    <div class="hidden sm:flex sm:items-center sm:space-x-6">
                        <a class="text-gray-700 hover:text-gray-900 px-3 py-2 text-sm font-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="text-gray-700 hover:text-gray-900 px-3 py-2 text-sm font-medium" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </div>

                <!-- Mobile menu -->
                <div id="mobile-menu" class="sm:hidden hidden pb-3">
                    <div class="space-y-1">
                        <a class="block text-gray-700 hover:bg-gray-100 hover:text-gray-900 px-3 py-2 text-base font-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="block text-gray-700 hover:bg-gray-100 hover:text-gray-900 px-3 py-2 text-base font-medium" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mx-auto px-4">
        <main role="main" class="pb-12">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-t text-gray-600">
        <div class="container mx-auto px-4">
            &copy; 2025 - CengizTest - <a class="text-blue-600 hover:text-blue-800" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>